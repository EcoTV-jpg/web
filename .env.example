# Google Indexing API Configuration (Server-Side Only)
# WARNING: NEVER prefix with VITE_ or commit actual keys to version control.
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...=\n-----END PRIVATE KEY-----\n"

# Master kill-switch for Google Indexing API notifications (default: false)
# When set to false, all calls are safely intercepted and skipped without contacting Google.
GOOGLE_INDEXING_ENABLED=false
