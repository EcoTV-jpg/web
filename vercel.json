{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.(?:svg|webp|jpg|jpeg|png|ico|avif|woff2))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(robots\\.txt|sitemap\\.xml|llms\\.txt|site\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "teleview.me"
        }
      ],
      "destination": "https://www.teleview.me/:path*",
      "permanent": true
    },
    {
      "source": "/best-iptv/tivimate",
      "destination": "/iptv-players/tivimate",
      "permanent": true
    },
    {
      "source": "/best-iptv/iptv-smarters-pro",
      "destination": "/iptv-players/iptv-smarters-pro",
      "permanent": true
    },
    {
      "source": "/best-iptv/ibo-player",
      "destination": "/iptv-players/ibo-player",
      "permanent": true
    },
    {
      "source": "/best-iptv/smartone",
      "destination": "/iptv-players/smartone",
      "permanent": true
    },
    {
      "source": "/best-iptv/gse-smart-iptv",
      "destination": "/iptv-players/gse-smart-iptv",
      "permanent": true
    },
    {
      "source": "/best-iptv/vlc",
      "destination": "/iptv-players/vlc",
      "permanent": true
    },
    {
      "source": "/best-iptv/ott-navigator",
      "destination": "/iptv-players/ott-navigator",
      "permanent": true
    },
    {
      "source": "/pricing",
      "destination": "/iptv-subscription",
      "permanent": true
    },
    {
